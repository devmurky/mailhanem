# Kopyalayıp .env.local yapın. .env.local sürüm kontrolüne girmez.

# Kutu parolalarının ana anahtarı. ZORUNLU.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILHANEM_ANAHTAR=

# İlk açılışta oluşturulacak operatör
OPERATOR_EPOSTA=operator@mailhanem.app
OPERATOR_AD=Enes Işhak

# Giriş bağlantılarındaki kök
UYGULAMA_KOKU=http://127.0.0.1:3100

# Tanıtım sayfasının kökleri (virgülle ayrılır)
SITE_KAYNAKLARI=http://127.0.0.1:8791,http://localhost:8791

# Canlı IMAP yerine diskteki .eml dosyalarını okumak için:
# POSTA_KAYNAGI=dosya:./ornek-posta

# Giden posta (SMTP). SMTP_SUNUCU boşsa uygulama mail göndermez,
# giriş bağlantısını ve daveti sunucu günlüğüne yazar.
SMTP_SUNUCU=
SMTP_PORT=587
# Boş bırakılırsa port 465 ise TLS, değilse STARTTLS varsayılır
SMTP_GUVENLI=
SMTP_KULLANICI=
SMTP_PAROLA=
SMTP_GONDEREN=Mailhanem <bildirim@mailhanem.app>

# Cloudflare Turnstile — giriş formunun bot koruması.
# İKİSİ BİRDEN boşsa koruma kapalıdır ve giriş çalışmaya devam eder.
# Anahtarlar: dash.cloudflare.com → Turnstile → site ekle
# Cloudflare'in belgelediği deneme anahtarları (her zaman geçer):
#   NEXT_PUBLIC_TURNSTILE_SITE=1x00000000000000000000AA
#   TURNSTILE_GIZLI=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE=
TURNSTILE_GIZLI=

# Bilgi deposu çıkarımı (Anthropic). BOŞSA ÇIKARIM ÇALIŞMAZ; panel bunu
# açıkça yazar ve depo elle doldurulabilir kalır. Anahtar eklendiğinde
# /kvkk sayfasındaki "dil modeline ne gidiyor" metni de kendiliğinden açılır.
# ANTHROPIC_API_KEY adı da okunuyor (ikisi varsa bu kazanır) — operatör
# panelindeki entegrasyon listesi o adla yazılmıştı, ikisi de çalışsın.
ANTHROPIC_ANAHTAR=
# Varsayılan: claude-sonnet-5
ZEKA_MODEL=
# Milyon token başına kuruş. Girilmezse maliyet sıfır yazılır, token yine
# kaydedilir — uydurma fiyatla marj hesaplatmaktansa "fiyat girilmemiş" demek
# doğru (operatör maliyet ekranı zaten varsayımla çalıştığını söylüyor).
ZEKA_KURUS_1M_GIRDI=
ZEKA_KURUS_1M_CIKTI=
